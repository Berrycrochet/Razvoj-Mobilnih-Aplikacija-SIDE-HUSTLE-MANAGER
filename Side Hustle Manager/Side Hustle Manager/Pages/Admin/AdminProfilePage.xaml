<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Side_Hustle_Manager.Pages.Admin.AdminProfilePage"
             Title="AdminProfilePage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Profilna slika -->
            <Image x:Name="ProfileImage"
                   HeightRequest="150"
                   WidthRequest="150"
                   Aspect="AspectFill"
                   HorizontalOptions="Center"
                   BackgroundColor="#DDD"
                   Source="avatar_placeholder.png"/>
            <Button Text="Change Profile Image" Clicked="OnChangeImageClicked"/>

            <!-- Ime, Naziv, Adresa, Kontakt -->
            <Entry x:Name="NameEntry" Placeholder="Name"/>
            <Entry x:Name="CompanyEntry" Placeholder="Company Name"/>
            <Entry x:Name="AddressEntry" Placeholder="Address"/>
            <Entry x:Name="ContactEntry" Placeholder="Contact Info"/>

            <Button Text="Save Changes" Clicked="OnSaveClicked"/>
      
    <Button Text="Odjavi se"
     Clicked="Logout_Clicked"/>

            <!-- Ratings Section -->
            <Label Text="Ratings" FontAttributes="Bold" FontSize="18"/>
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="Stars:" VerticalOptions="Center"/>
                <Picker x:Name="StarPicker" Title="Select rating">
                    <Picker.Items>
                        <x:String>1</x:String>
                        <x:String>2</x:String>
                        <x:String>3</x:String>
                        <x:String>4</x:String>
                        <x:String>5</x:String>
                    </Picker.Items>
                </Picker>
            </HorizontalStackLayout>

            <Entry x:Name="CommentEntry" Placeholder="Add a comment (optional)" />
            <Button Text="Submit Rating" Clicked="OnSubmitRatingClicked"/>

            <Label x:Name="AverageRatingLabel" Text="Average: 0/5" FontAttributes="Bold" />
            <CollectionView x:Name="RatingsCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="5" Padding="5" CornerRadius="5" BackgroundColor="#F0F0F0">
                            <VerticalStackLayout>
                                <Label Text="{Binding RatedByUsername}" FontAttributes="Bold"/>
                                <Label Text="{Binding Stars, StringFormat='Stars: {0}'}"/>
                                <Label Text="{Binding Comment}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>