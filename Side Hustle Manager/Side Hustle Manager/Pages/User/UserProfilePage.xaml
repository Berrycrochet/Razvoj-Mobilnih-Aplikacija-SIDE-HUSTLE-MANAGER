<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="Side_Hustle_Manager.Pages.User.UserProfilePage"
             x:Name="UserProfilePageRoot"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- NASLOV -->
            <Label Text="Profil korisnika"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#2ECC71"/>

            <!-- PROFIL KARTICA -->
            <Frame CornerRadius="20"
                   Padding="20"
                   BackgroundColor="White"
                   HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <!-- PROFILNA SLIKA -->
                    <Frame Padding="3"
                           BorderColor="#2ECC71"
                           HasShadow="False"
                           HorizontalOptions="Start">

                        <Image x:Name="ProfileImage"
                               HeightRequest="150"
                               WidthRequest="150"
                               Aspect="AspectFill"
                               Source="avatar_placeholder.png"/>
                    </Frame>

                    <Button x:Name="ChangeImageButton"
                            Text="Change Profile Image"
                            BackgroundColor="#2ECC71"
                            TextColor="White"
                            CornerRadius="12"
                            Clicked="OnChangeImageClicked"
                            IsVisible="False"/>

                    <!-- SKILLS -->
                    <Label Text="Skills"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,10,0,0"/>

                    <Entry x:Name="SkillEntry"
                           Placeholder="Add new skill"
                           IsVisible="False"/>

                    <Button x:Name="AddSkillButton"
                            Text="Add Skill"
                            BackgroundColor="#2ECC71"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="OnAddSkillClicked"
                            IsVisible="False"/>

                    <CollectionView x:Name="SkillsCollection">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding SkillName}"
                                           VerticalOptions="Center"/>
                                    <Button Text="Delete"
                                            Clicked="OnDeleteSkillClicked"
                                            IsVisible="{Binding Source={x:Reference UserProfilePageRoot}, Path=BindingContext.IsEditMode}"/>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- EXPERIENCE -->
                    <Label Text="Experience"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,15,0,5"/>

                    <Entry x:Name="ExperienceTitleEntry"
                           Placeholder="Naziv"
                           IsVisible="False"/>

                    <Entry x:Name="ExperienceCompanyEntry"
                           Placeholder="Kompanija"
                           IsVisible="False"/>

                    <HorizontalStackLayout x:Name="ExperienceDatePickers"
                                           IsVisible="False"
                                           Spacing="10">
                        <DatePicker x:Name="ExperienceStartDate"
                                    MaximumDate="{x:Static sys:DateTime.Now}"/>
                        <Label Text="to" VerticalOptions="Center"/>
                        <DatePicker x:Name="ExperienceEndDate"
                                    MaximumDate="{x:Static sys:DateTime.Now}"/>
                    </HorizontalStackLayout>

                    <Button x:Name="AddExperienceButton"
                            Text="Add Experience"
                            BackgroundColor="#2ECC71"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="OnAddExperienceClicked"
                            IsVisible="False"/>

                    <CollectionView x:Name="ExperienceCollection">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="5"
                                       Padding="10"
                                       CornerRadius="12"
                                       BackgroundColor="#F9F9F9"
                                       HasShadow="True">

                                    <VerticalStackLayout>
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding Company}"
                                               FontAttributes="Italic"/>
                                        <Label Text="{Binding Period}"
                                               TextColor="#555"/>
                                        <Button Text="Delete"
                                                Clicked="OnDeleteExperienceClicked"
                                                IsVisible="{Binding Source={x:Reference UserProfilePageRoot}, Path=BindingContext.IsEditMode}"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Frame>

            <!-- EDIT DUGMAD -->
            <HorizontalStackLayout Spacing="10">
                <Button x:Name="EditProfileButton"
                        Text="Edit My Profile"
                        BackgroundColor="#2ECC71"
                        TextColor="White"
                        CornerRadius="12"
                        Clicked="OnEditProfileClicked"/>

                <Button x:Name="SaveProfileButton"
                        Text="Save"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        CornerRadius="12"
                        Clicked="OnSaveProfileClicked"
                        IsVisible="False"/>

                <Button x:Name="CancelEditButton"
                        Text="Cancel"
                        BackgroundColor="#95A5A6"
                        TextColor="White"
                        CornerRadius="12"
                        Clicked="OnCancelEditClicked"
                        IsVisible="False"/>
            </HorizontalStackLayout>

            <!-- LOCATION -->
            <Label x:Name="LocationLabel"
                   Text="Your location will appear here"/>

            <Button Text="Dohvati moju lokaciju"
                    BackgroundColor="#2ECC71"
                    TextColor="White"
                    CornerRadius="12"
                    Clicked="OnGetLocationClicked"/>

            <!-- LOGOUT -->
            <Button Text="Odjavi se"
                    BackgroundColor="#E74C3C"
                    TextColor="White"
                    CornerRadius="14"
                    Clicked="OnLogoutClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
